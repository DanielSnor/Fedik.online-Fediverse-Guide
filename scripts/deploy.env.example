# Deploy konfigurace pro sync_local_to_test.sh — ZKOPÍRUJ na scripts/deploy.env.
#   cp scripts/deploy.env.example scripts/deploy.env
# scripts/deploy.env je v .gitignore. Pozn.: tohle NENÍ runtime config.env.
#
# Autentizace: používá se tvůj SSH klíč/certifikát (ssh-agent / ~/.ssh/config),
# stejně jako u ostatních aplikací → HESLO se nezadává a nikam neukládá.

# --- Varianta A (doporučeno): alias z ~/.ssh/config ---
# Když se na server běžně hlásíš `ssh muj-server`, dej sem ten alias. Host, port,
# uživatel i klíč/cert se vezmou z ~/.ssh/config — víc nic vyplňovat nemusíš.
FEDIK_REMOTE="muj-server"
FEDIK_REMOTE_DIR="/app/data/fedik-test"      # TEST app na serveru
# FEDIK_REMOTE_PORT=        # NECH PRÁZDNÉ při použití aliasu (port je v ssh/config)

# --- Varianta B: přímo user@host ---
# FEDIK_REMOTE="user@1.2.3.4"
# FEDIK_REMOTE_PORT="202"           # port SSH (Cloudron bývá 202)
# FEDIK_SSH_OPTS="-i ~/.ssh/id_ed25519"   # jen když klíč není default/v agentu

# Volitelné: když cílová cesta potřebuje root práva.
# FEDIK_RSYNC_PATH="sudo rsync"
